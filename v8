<script>
(function(){
  var h1   = document.querySelector('.brand'),
      txt  = document.getElementById('brandType'),
      full = txt.textContent,
      reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches,
      TYPE = true,
      BASE = 90;

  if (!TYPE || reduce || !full){
    h1.classList.add('ver-in');
    return;
  }

  txt.textContent = '';
  h1.classList.add('typing');
  var i = 0;
  (function type(){
    txt.textContent = full.slice(0, ++i);
    if (i < full.length){
      setTimeout(type, BASE + Math.random() * 70);
    } else {
      h1.classList.remove('typing');
      setTimeout(function(){ h1.classList.add('ver-in'); }, 180);
    }
  })();
})();

(function(){
  var el = document.getElementById('oemType');
  if (!el) return;
  var word = el.textContent;
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  var TYPE_MS   = 110,
      HOLD_MS   = 2200,
      ERASE_MS  = 55,
      GAP_MS    = 700,
      START_DELAY = 350;

  if (reduce || !word) return;

  setTimeout(function(){
    el.textContent = '';
    type(0);
  }, START_DELAY);

  function type(i){
    el.textContent = word.slice(0, i + 1);
    if (i + 1 < word.length){
      setTimeout(function(){ type(i + 1); }, TYPE_MS + Math.random() * 60);
    } else {
      setTimeout(eraseAll, HOLD_MS);
    }
  }
  function eraseAll(){
    var n = word.length;
    (function del(){
      el.textContent = word.slice(0, --n);
      if (n > 0){
        setTimeout(del, ERASE_MS);
      } else {
        setTimeout(function(){ type(0); }, GAP_MS);
      }
    })();
  }
})();
</script>

