    const ex = prompts.find(x => x.id === s.id);
    if (ex){ Object.assign(ex, s); updated++; }
    else { prompts.push(s); added++; }
  });
  savePrompts();
  renderPrompts();
  toast('Imported ' + added + ' new, updated ' + updated);
}));

/* =========================================================
   GLOBAL SHORTCUTS
   ========================================================= */
document.addEventListener('keydown', e => {
  const mod = e.ctrlKey || e.metaKey;

  if (e.key === 'Escape' && MODAL_STACK.length){
    const top = MODAL_STACK[MODAL_STACK.length - 1];
    if (top === scOvl){ if (scListView.hidden) showView('list'); else closeSc(); }
    else modalClose(top);
    return;
  }

  if (e.altKey && !e.ctrlKey && !e.metaKey && !e.shiftKey && (e.key === '1' || e.key === '2' || e.key === '3')){
    e.preventDefault();
    setTab(e.key === '1' ? 'crp' : e.key === '2' ? 'tools' : 'prompts', false);
    return;
  }

  if (e.altKey && !e.ctrlKey && !e.metaKey && !e.shiftKey && (e.code === 'KeyQ' || e.key === 'q' || e.key === 'Q')){
    e.preventDefault();
    openSc();
    return;
  }

  if (e.altKey && !e.ctrlKey && !e.metaKey && !e.shiftKey && (e.code === 'KeyW' || e.key === 'w' || e.key === 'W')){
    e.preventDefault();
    openDisc();
    return;
  }

  if (MODAL_STACK.length) return;

  if (mod && (e.key === 'ArrowDown' || e.key === 'ArrowUp')){
    const t = e.target;
    if (t && (t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.tagName === 'INPUT')) return;
    e.preventDefault();
    const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollBy({
      top: (e.key === 'ArrowDown' ? 1 : -1) * Math.round(window.innerHeight * 0.85),
      behavior: reduce ? 'auto' : 'smooth'
    });
    return;
  }

  if (activeTab !== 'crp') return;

  if (mod && !e.shiftKey && (e.key === 'z' || e.key === 'Z') && undoSnap){ e.preventDefault(); undoReset(); return; }
  if (mod && e.shiftKey && e.key === 'Enter'){ e.preventDefault(); $('#copyBtn').click(); return; }
  if (mod && !e.shiftKey && e.key === 'Enter'){ e.preventDefault(); requestGenerate(); return; }

  if (mod && (e.key === 'x' || e.key === 'X')){
    const t = e.target;
    const typing = t && (t.isContentEditable || t.tagName === 'TEXTAREA' ||
      (t.tagName === 'INPUT' && !/^(checkbox|radio|button|submit|reset|range|color|file|image)$/.test(t.type)));
    if (typing && (typeof t.selectionStart !== 'number' || t.selectionStart !== t.selectionEnd)) return;
    e.preventDefault();
    const wasArmed = rb.classList.contains('armed');
    armReset();
    if (!wasArmed) toast('Reset armed \u2014 press Ctrl+X again to confirm');
  }
});

/* =========================================================
   TOOLS TAB
   ========================================================= */
const PH_TZ = 'Asia/Manila';
const STATES = [
  { id:'east', label:'NSW / VIC / TAS / ACT', tz:'Australia/Sydney',   short:'AEDT/AEST' },
  { id:'qld',  label:'QLD',                   tz:'Australia/Brisbane', short:'AEST' },
  { id:'sa',   label:'SA / NT',               tz:'Australia/Adelaide', short:'ACDT/ACST' },
  { id:'wa',   label:'WA',                    tz:'Australia/Perth',    short:'AWST' }
];

function zparts(date, tz){
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: tz, hour12: false,
    year:'numeric', month:'2-digit', day:'2-digit',
    hour:'2-digit', minute:'2-digit', second:'2-digit', weekday:'short'
  });
  const p = {};
  fmt.formatToParts(date).forEach(x => { p[x.type] = x.value; });
  let hh = parseInt(p.hour, 10); if (hh === 24) hh = 0;
  return {
    y:+p.year, mo:+p.month, d:+p.day, h:hh, mi:+p.minute, s:+p.second,
    wd:p.weekday
  };
}

function fmt12(h, mi){
  const ap = h >= 12 ? 'PM' : 'AM';
  let h12 = h % 12; if (h12 === 0) h12 = 12;
  return h12 + ':' + String(mi).padStart(2, '0') + ' ' + ap;
}

function zoneOffsetMin(date, tz){
  const utcP = zparts(date, 'UTC');
  const tzP  = zparts(date, tz);
  const uMin = Date.UTC(utcP.y, utcP.mo-1, utcP.d, utcP.h, utcP.mi);
  const tMin = Date.UTC(tzP.y,  tzP.mo-1,  tzP.d,  tzP.h,  tzP.mi);
  return Math.round((tMin - uMin) / 60000);
}
function offLabel(min){
  if (min === 0) return '±0h';
  const sign = min > 0 ? '+' : '-';
  const abs = Math.abs(min);
  const h = Math.floor(abs / 60);
  const m = abs % 60;
  if (m === 0) return sign + h + 'h';
  if (m === 30) return sign + h + '.5h';
  return sign + h + 'h' + String(m).padStart(2,'0');
}

function callLight(localMinutes){
  if (localMinutes >= 540 && localMinutes < 1020) return 'ok';
  if ((localMinutes >= 420 && localMinutes < 540) ||
      (localMinutes >= 1020 && localMinutes < 1140)) return 'amber';
  return 'red';
}
const LIGHT_LABEL = { ok:'CALL NOW', amber:'EARLY/LATE', red:'OFF HOURS' };

const clockList = $('#clockList'), phNow = $('#phNow'), tzUpdated = $('#tzUpdated');

clockList.innerHTML = STATES.map(s => (
  '<li class="clockRow" data-tz="' + s.tz + '" data-label="' + esc(s.label) + '" tabindex="0" role="button" aria-label="Copy time for ' + esc(s.label) + '">' +
    '<span class="dot" aria-hidden="true"></span>' +
    '<span class="name">' + esc(s.label) + '<small>' + esc(s.short) + '</small></span>' +
    '<span class="time">&mdash;</span>' +
    '<span class="tz"></span>' +
    '<span class="off"></span>' +
    '<span class="badge">&mdash;</span>' +
  '</li>'
)).join('');

function tickClocks(){
  const now = new Date();

  const phP = zparts(now, PH_TZ);
  phNow.textContent = phP.wd + ' ' + phP.d + ' ' + monthName(phP.mo) + ', ' + fmt12(phP.h, phP.mi);

  $$('.clockRow', clockList).forEach(row => {
    const tz = row.dataset.tz;
    const p  = zparts(now, tz);
    const localMin = p.h * 60 + p.mi;
    const light = callLight(localMin);
    const off = zoneOffsetMin(now, tz) - zoneOffsetMin(now, PH_TZ);

    row.querySelector('.dot').className = 'dot ' + light;
    row.querySelector('.time').textContent = fmt12(p.h, p.mi);
    row.querySelector('.tz').textContent   = abbrFor(tz, now);
    row.querySelector('.off').textContent  = offLabel(off) + ' vs PH';
    const badge = row.querySelector('.badge');
    badge.className = 'badge ' + light;
    badge.textContent = LIGHT_LABEL[light];
  });

  tzUpdated.textContent = 'updated ' + fmt12(phP.h, phP.mi) + ' PH';
}
function monthName(m){
  return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][m-1];
}
function abbrFor(tz, date){
  try {
    const parts = new Intl.DateTimeFormat('en-AU', { timeZone: tz, timeZoneName:'short' }).formatToParts(date);
    const name = parts.find(p => p.type === 'timeZoneName');
    if (name && name.value) return name.value;
  } catch(e){}
  const s = STATES.find(x => x.tz === tz);
  if (!s) return '';
  const slash = s.short.indexOf('/');
  if (slash < 0) return s.short;
  const p = zparts(date, tz);
  const inDst = p.mo >= 10 || p.mo <= 3;
  return inDst ? s.short.slice(0, slash) : s.short.slice(slash + 1);
}

clockList.addEventListener('click', e => {
  const row = e.target.closest('.clockRow'); if (!row) return;
  copyRowTime(row);
});
clockList.addEventListener('keydown', e => {
  if (e.key === 'Enter' || e.key === ' '){
    const row = e.target.closest('.clockRow'); if (!row) return;
    e.preventDefault(); copyRowTime(row);
  }
});
function copyRowTime(row){
  const tz = row.dataset.tz;
  const label = row.dataset.label;
  const now = new Date();
  const p = zparts(now, tz);
  const abbr = abbrFor(tz, now);
  const txt = label + ' \u2014 ' + fmt12(p.h, p.mi) + ' ' + abbr + ' (' + p.wd + ')';
  copyText(txt, '\u2014 ' + label, 'Copy blocked \u2014 select and press Ctrl+C');
}

/* --- Discount calculator (no GST) --- */
const discOrig   = $('#discOrig');
const discNew    = $('#discNew');
const discPct    = $('#discPct');
const discNewWrap= $('#discNewWrap');
const discPctWrap= $('#discPctWrap');
const discResult = $('#discResult');
const quickPctRow= $('#quickPctRow');

const QUICK_PCTS = [5, 10, 15, 20, 25];
quickPctRow.innerHTML = QUICK_PCTS.map(p => (
  '<button type="button" class="pctChip" data-pct="' + p + '">' + p + '%</button>'
)).join('');

function parseMoney(s){
  if (!s) return NaN;
  const n = parseFloat(String(s).replace(/[^0-9.\-]/g, ''));
  return isFinite(n) ? n : NaN;
}
function money(n){
  if (!isFinite(n)) return '$0.00';
  return '$' + n.toFixed(2);
}
function currentMode(){
  const r = $('input[name=discMode]:checked');
  return r ? r.value : 'pct';
}
function updateDiscMode(){
  const mode = currentMode();
  if (mode === 'pct'){
    discNewWrap.hidden = false;
    discPctWrap.hidden = true;
  } else {
    discNewWrap.hidden = true;
    discPctWrap.hidden = false;
  }
  renderDisc();
}
 $$('input[name=discMode]').forEach(r => r.addEventListener('change', updateDiscMode));
[discOrig, discNew, discPct].forEach(el => el.addEventListener('input', renderDisc));

quickPctRow.addEventListener('click', e => {
  const b = e.target.closest('.pctChip'); if (!b) return;
  const pct = parseFloat(b.dataset.pct);
  if (currentMode() !== 'price'){
    $('input[name=discMode][value=price]').checked = true;
    updateDiscMode();
  }
  discPct.value = String(pct);
  renderDisc();
});

let lastDiscResult = '';
function renderDisc(){
  const mode = currentMode();
  const orig = parseMoney(discOrig.value);
  let pct, finalPrice, saved;

  if (mode === 'pct'){
    const newP = parseMoney(discNew.value);
    if (!isFinite(orig) || !isFinite(newP) || orig <= 0){
      discResult.innerHTML = '<div class="empty">Enter original and discounted price…</div>';
      lastDiscResult = '';
      return;
    }
    finalPrice = newP;
    saved = orig - newP;
    pct = saved / orig * 100;
  } else {
    const p = parseFloat(discPct.value);
    if (!isFinite(orig) || !isFinite(p) || orig <= 0){
      discResult.innerHTML = '<div class="empty">Enter original price and discount %…</div>';
      lastDiscResult = '';
      return;
    }
    pct = p;
    saved = orig * p / 100;
    finalPrice = orig - saved;
  }

  if (saved < 0 || finalPrice < 0){
    discResult.innerHTML = '<div class="empty bad">Check the numbers \u2014 the discounted price can\u2019t be above the original or below $0.</div>';
    lastDiscResult = '';
    return;
  }

  const pctStr = (Math.round(pct * 100) / 100).toFixed(2) + '%';

  discResult.innerHTML =
    '<div class="row big"><span>You save</span><b>' + money(saved) + ' <span style="color:var(--mut);font-weight:600;">(' + pctStr + ')</span></b></div>' +
    '<div class="row big"><span>Customer pays</span><b>' + money(finalPrice) + '</b></div>' +
    '<div class="sep"></div>' +
    '<div class="row"><span>Original</span><b>' + money(orig) + '</b></div>';

  lastDiscResult =
    money(orig) + ' \u2192 ' + money(finalPrice) +
    ' (' + pctStr + ' off, save ' + money(saved) + ')';
}

 $('#discCopyBtn').addEventListener('click', () => {
  if (!lastDiscResult){ toast('Nothing to copy yet', true); return; }
  copyText(lastDiscResult, '\u2014 discount result', 'Copy blocked \u2014 select and press Ctrl+C');
});
 $('#discClearBtn').addEventListener('click', () => {
  discOrig.value = ''; discNew.value = ''; discPct.value = '';
  renderDisc();
  discOrig.focus();
});

/* --- Callback converter --- */
const cbState = $('#cbState');
const cbTime  = $('#cbTime');
const cbDate  = $('#cbDate');
const cbOut   = $('#cbOut');
const cbQuick = $('#cbQuick');
const cbTimeLab = $('#cbTimeLab');

cbState.innerHTML = STATES.map(s => '<option value="' + s.id + '">' + esc(s.label) + '</option>').join('');

const QUICK_TIMES = [
  { h:9,  mi:0,  label:'9:00 AM' },
  { h:12, mi:0,  label:'12:00 PM' },
  { h:14, mi:0,  label:'2:00 PM' },
  { h:16, mi:0,  label:'4:00 PM' }
];
cbQuick.innerHTML = QUICK_TIMES.map((q, i) => (
  '<button type="button" class="pctChip" data-qi="' + i + '">' + q.label + '</button>'
)).join('');

function currentCbDir(){
  const r = $('input[name=cbDir]:checked');
  return r ? r.value : 'ph2au';
}
function stateById(id){ return STATES.find(s => s.id === id) || STATES[0]; }

function wallTimeToUtc(y, mo, d, h, mi, tz){
  let guess = Date.UTC(y, mo-1, d, h, mi, 0);
  for (let i = 0; i < 2; i++){
    const p = zparts(new Date(guess), tz);
    const gotWall = Date.UTC(p.y, p.mo-1, p.d, p.h, p.mi);
    const wantWall = Date.UTC(y, mo-1, d, h, mi);
    guess += (wantWall - gotWall);
  }
  return new Date(guess);
}
function dayShift(date, days){
  const d = new Date(date.getTime());
  d.setUTCDate(d.getUTCDate() + days);
  return d;
}

let lastCbResult = '';
let lastCbSig = '';
let cbDateTouched = false;                       // once you pick a date yourself, it stops following "today"
const pad2 = n => (n < 10 ? '0' : '') + n;
function cbSrcTz(){ return currentCbDir() === 'ph2au' ? PH_TZ : stateById(cbState.value).tz; }
function dateKey(p){ return p.y + '-' + pad2(p.mo) + '-' + pad2(p.d); }
function dateLab(p){ return p.wd + ' ' + p.d + ' ' + monthName(p.mo); }
function syncDefaultDate(){                      // default = today in the time zone you're typing the time in
  if (!cbDateTouched) cbDate.value = dateKey(zparts(new Date(), cbSrcTz()));
}
function dayTag(p, tz){                          // " (today)" / " (tomorrow)" / " (yesterday)" or nothing
  const t = zparts(new Date(), tz);
  const diff = Math.round((Date.UTC(p.y, p.mo-1, p.d) - Date.UTC(t.y, t.mo-1, t.d)) / 86400000);
  return diff === 0 ? ' (today)' : diff === 1 ? ' (tomorrow)' : diff === -1 ? ' (yesterday)' : '';
}
function renderCallback(){
  const dir = currentCbDir();
  const state = stateById(cbState.value);
  const say = (t, bad) => { cbOut.innerHTML = '<div class="empty' + (bad ? ' bad' : '') + '">' + t + '</div>'; lastCbResult = ''; lastCbSig = cbSig(); };

  const m = cbTime.value.match(/^(\d{1,2}):(\d{2})/);
  if (!m) return say('Pick a time…');
  const dm = cbDate.value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!dm) return say('Pick a date…');
  const hh = parseInt(m[1], 10), mi = parseInt(m[2], 10);

  const srcTz  = dir === 'ph2au' ? PH_TZ : state.tz;
  const srcUtc = wallTimeToUtc(+dm[1], +dm[2], +dm[3], hh, mi, srcTz);
  const back = zparts(srcUtc, srcTz);
  if (back.h !== hh || back.mi !== mi)
    return say('That clock time doesn\u2019t exist on that date (daylight saving change) \u2014 pick another time.', true);

  const phP    = zparts(srcUtc, PH_TZ);
  const auP    = zparts(srcUtc, state.tz);
  const auAbbr = abbrFor(state.tz, srcUtc);
  const phAbbr = 'PH';

  const phStr = fmt12(phP.h, phP.mi);
  const auStr = fmt12(auP.h, auP.mi);
  const phDay = dateLab(phP) + dayTag(phP, PH_TZ);
  const auDay = dateLab(auP) + dayTag(auP, state.tz);

  const terse =
    'Callback ' + auStr.replace(' ', '') + ' ' + auAbbr + ' ' + dateLab(auP) +
    ' = ' + phStr.replace(' ', '') + ' ' + phAbbr +
    (dateKey(phP) === dateKey(auP) ? '' : ' ' + dateLab(phP));      // PH date only when it differs from the AU date
  const past = srcUtc.getTime() < Date.now() - 60000
    ? '<div class="cbSmall bad">That time has already passed.</div>' : '';

  if (dir === 'ph2au'){
    cbOut.innerHTML =
      '<div class="cbLine">AU customer hears: <b>' + auStr + '</b> on ' + esc(auDay) + ' <span style="color:var(--mut);font-size:12px;">' + esc(state.label) + ' &middot; ' + esc(auAbbr) + '</span></div>' +
      '<div class="cbSmall">That\'s <b>' + phStr + '</b> ' + esc(phAbbr) + ' (' + esc(phDay) + ') your time.</div>' + past +
      '<div class="cbQuote" id="cbQuote">' + esc(terse) + '</div>';
  } else {
    cbOut.innerHTML =
      '<div class="cbLine">When it\'s <b>' + auStr + '</b> on ' + esc(auDay) + ' for them <span style="color:var(--mut);font-size:12px;">(' + esc(state.label) + ' &middot; ' + esc(auAbbr) + ')</span>,</div>' +
      '<div class="cbSmall">it\'s <b>' + phStr + '</b> ' + esc(phAbbr) + ' (' + esc(phDay) + ') your time.</div>' + past +
      '<div class="cbQuote" id="cbQuote">' + esc(terse) + '</div>';
  }
  lastCbResult = terse;
  lastCbSig = cbSig();
}
 $$('input[name=cbDir]').forEach(r => r.addEventListener('change', () => {
  const dir = currentCbDir();
  cbTimeLab.textContent = dir === 'ph2au' ? 'PH time' : 'AU time';
  $('#cbDateLab').textContent = dir === 'ph2au' ? 'Date (PH)' : 'Date (AU)';
  syncDefaultDate();
  renderCallback();
}));
cbState.addEventListener('change', () => { syncDefaultDate(); renderCallback(); });
cbTime.addEventListener('input', renderCallback);
cbDate.addEventListener('input',  () => { cbDateTouched = true; renderCallback(); });
cbDate.addEventListener('change', () => { cbDateTouched = true; renderCallback(); });

const cbDayQuick = $('#cbDayQuick');
cbDayQuick.innerHTML =
  '<button type="button" class="pctChip" data-day="0">Today</button>' +
  '<button type="button" class="pctChip" data-day="1">Tomorrow</button>';
cbDayQuick.addEventListener('click', e => {
  const b = e.target.closest('.pctChip'); if (!b) return;
  const n = parseInt(b.dataset.day, 10);
  cbDateTouched = n !== 0;                        // "Today" goes back to following today
  const p = zparts(new Date(), cbSrcTz());
  const d = new Date(Date.UTC(p.y, p.mo-1, p.d + n));
  cbDate.value = d.getUTCFullYear() + '-' + pad2(d.getUTCMonth() + 1) + '-' + pad2(d.getUTCDate());
  renderCallback();
});

cbQuick.addEventListener('click', e => {
  const b = e.target.closest('.pctChip'); if (!b) return;
  const q = QUICK_TIMES[parseInt(b.dataset.qi, 10)];
  if (!q) return;
  cbTime.value = String(q.h).padStart(2,'0') + ':' + String(q.mi).padStart(2,'0');
  renderCallback();
});

 $('#cbCopyBtn').addEventListener('click', () => {
  if (!lastCbResult){ toast('Nothing to copy yet', true); return; }
  copyText(lastCbResult, '\u2014 callback time', 'Copy blocked \u2014 select and press Ctrl+C');
});
 $('#cbResetBtn').addEventListener('click', () => {
  const now = new Date();
  const dir = currentCbDir();
  const srcTz = dir === 'ph2au' ? PH_TZ : stateById(cbState.value).tz;
  const p = zparts(now, srcTz);
  cbTime.value = String(p.h).padStart(2,'0') + ':' + String(p.mi).padStart(2,'0');
  cbDateTouched = false; syncDefaultDate();
  renderCallback();
});

function cbSig(){
  return cbTime.value + '|' + cbDate.value + '|' + currentCbDir() + '|' + cbState.value + '|' + Math.floor(Date.now() / 60000);
}
let toolsTimer = null;
function tickTools(){
  tickClocks();
  const sig = cbSig();                            // only rebuild the panel when something visible changed
  if (sig !== lastCbSig){ syncDefaultDate(); renderCallback(); }
}
function startToolsTicker(){
  if (toolsTimer) return;
  const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  const every = reduce ? 60000 : 15000;
  toolsTimer = setInterval(() => {
    if (activeTab === 'tools') tickTools();
  }, every);
}

/* =========================================================
   BOOT
   ========================================================= */
render();
updateDiscMode();
syncDefaultDate();
renderCallback();
tickClocks();
setTab(activeTab, false);
startToolsTicker();

/* Warn before losing an in-progress note to a refresh or close.
   Privacy-safe: nothing is written anywhere — this only decides whether to ask. */
window.addEventListener('beforeunload', e => {
  if (hasContent(capture()) || (!linked && out.value.trim())){
    e.preventDefault();
    e.returnValue = '';
  }
});

})();
