/* ---------- Check-before-copy safety net ----------
   VM is read from the chip state directly so the warning fires regardless of
   how the Additional notes line was typed or edited. Text fallback remains.
   Case ID only warns once the note has real content somewhere else, so a
   pristine form never shows a nagging pill. */
const LABELS = {
  caseid:   'Case ID',
  spoke:    'Spoke with',
  obd:      'OB Disclaimer',
  offered:  'Offered voucher',
  vcode:    'Voucher code given',
  vdisc:    'Voucher Disclaimer',
  reason:   'Reason for declining the voucher',
  notes:    'Additional notes',
  products: 'Product/s Offered'
};
function parseNote(txt){
  const lines = String(txt).split('\n'), got = {};
  Object.keys(LABELS).forEach(k => {
    const key = LABELS[k].toUpperCase() + ':';
    const i = lines.findIndex(l => l.trim().toUpperCase().indexOf(key) === 0);
    got[k] = i < 0 ? null : lines[i].slice(lines[i].indexOf(':') + 1).trim();
  });
  return got;
}
const isNA  = v => v === null || v === '' || /^n\/?a$/i.test(v);
const isYes = v => /^yes$/i.test(v || '');

function warnings(txt){
  const g = parseNote(txt), W = [];
  const na = k => isNA(g[k]), yes = k => isYes(g[k]);

  const answered   = !na('spoke');
  const vmFromChip = chk('qvm');
  const vmFromText = /reached[\s\u00a0]*vm/i.test(g.notes || '');
  const vm         = vmFromChip || vmFromText;
  const codeGiven  = !na('vcode'), reasonGiven = !na('reason');

  const noteStarted =
    !na('caseid') || !na('spoke') || !na('obd') || !na('offered') ||
    !na('vcode')  || !na('vdisc') || !na('reason') || !na('notes') || !na('products');
  if (na('caseid') && noteStarted)
    W.push('Case ID is not entered.');

  if (vm && answered)
    W.push('Reached VM is noted, but "Spoke with" has a name.');
  if (answered && na('obd'))
    W.push('You spoke with someone, but OB Disclaimer is still ' + NA + '.');
  if (answered && na('offered'))
    W.push('You spoke with someone, but "Offered voucher" is still ' + NA + '.');
  if ((yes('offered') || codeGiven) && !yes('vdisc'))
    W.push('Voucher offered or code given, but Voucher Disclaimer isn\u2019t Yes.');
  if (yes('offered') && !codeGiven && !reasonGiven)
    W.push('Voucher offered, but there\u2019s no code and no reason for declining.');
  if (codeGiven && reasonGiven)
    W.push('Both a voucher code and a decline reason are filled in \u2014 check which one is right.');
  if (!yes('offered') && (codeGiven || reasonGiven || yes('vdisc')))
    W.push('Voucher lines are filled in, but "Offered voucher" isn\u2019t Yes.');
  return W;
}

