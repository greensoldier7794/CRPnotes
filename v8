/* =========================================================
   MODAL MANAGER — focus restore, page inert, Esc closes topmost
   ========================================================= */
const MODAL_STACK = [];                 // open order; Esc always closes the last one opened
const MODAL_RETURN = new Map();         // overlay -> element focus goes back to on close
const INERT_ROOTS = () => $$('#pane-crp, #pane-tools, #pane-prompts, header.mast, nav.tabs, footer.foot');

function modalOpen(ovl, focusEl){
  if (!MODAL_STACK.includes(ovl)) MODAL_STACK.push(ovl);
  MODAL_RETURN.set(ovl, document.activeElement);
  INERT_ROOTS().forEach(el => el.setAttribute('inert', ''));
  ovl.hidden = false;
  if (focusEl) focusEl.focus();
}
function modalClose(ovl){
  const i = MODAL_STACK.lastIndexOf(ovl);
  if (i >= 0) MODAL_STACK.splice(i, 1);
  ovl.hidden = true;
  if (!MODAL_STACK.length) INERT_ROOTS().forEach(el => el.removeAttribute('inert'));
  const back = MODAL_RETURN.get(ovl);
  MODAL_RETURN.delete(ovl);
  if (back && back.isConnected && typeof back.focus === 'function') back.focus();
}

