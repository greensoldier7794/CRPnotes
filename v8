      let tag = '';
      if (mode === 'code' && PH_ALIKE.some(g => g.indexOf(u) >= 0)) tag = /[0-9]/.test(u) ? 'NUMBER' : 'LETTER';
      return { ch: u, word: PH_WORDS[u] || symbols[c] || symbols[u] || '', tag: tag };
    })
  );
