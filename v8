/* ---------- Shared JSON backup helpers (used by Scripts and Prompts) ---------- */
function backupDownload(kind, list, base){
  if (!list.length){ toast('Nothing to export yet', true); return; }
  const payload = JSON.stringify(
    { app: 'crp-notes', kind: kind, version: 1, exported: new Date().toISOString(), items: list },
    null, 2
  );
  const blob = new Blob([payload], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = base + '-' + new Date().toISOString().slice(0, 10) + '.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  toast('Exported ' + list.length + ' item' + (list.length === 1 ? '' : 's'));
}
function backupPick(onFile){
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = '.json,application/json';
  inp.hidden = true;
  document.body.appendChild(inp);
  inp.addEventListener('change', () => {
    const f = inp.files && inp.files[0];
    inp.value = '';
    inp.remove();
    if (!f) return;
    const reader = new FileReader();
    reader.onload = () => {
      let data = null;
      try { data = JSON.parse(String(reader.result)); } catch(err){ data = null; }
      onFile(data);
    };
    reader.onerror = () => toast('Could not read that file', true);
    reader.readAsText(f);
  });
  inp.click();
}

/* ---------- Scripts backup: Export / Import (JSON) ----------
   Export writes every script to a dated .json file. Import merges by id:
   matching ids update in place, new ids are appended — so re-importing your
   own backup is safe and sharing backups can't wipe local edits. */
function sanitizeScripts(raw){
  if (!Array.isArray(raw)) return null;
  const out = [];
  raw.forEach(s => {
    if (!s || typeof s.text !== 'string' || !s.text.trim()) return;
    out.push({
      id: (typeof s.id === 'string' && s.id) ? s.id : scId(),
      title: (typeof s.title === 'string' && s.title.trim()) ? s.title.trim() : 'Untitled script',
      cat: (typeof s.cat === 'string' && s.cat.trim()) ? s.cat.trim() : 'General',
      text: s.text
    });
  });
  return out;
}
 $('#scExport').addEventListener('click', () => backupDownload('scripts', scripts, 'crp-scripts'));
 $('#scImport').addEventListener('click', () => backupPick(data => {
  let raw = null;
  if (Array.isArray(data)) raw = data;
  else if (data && Array.isArray(data.items)) raw = data.items;
  else if (data && Array.isArray(data.scripts)) raw = data.scripts;
  const incoming = sanitizeScripts(raw);
  if (!incoming){ toast('That file isn\u2019t a scripts backup', true); return; }
  if (!incoming.length){ toast('No valid scripts in that file', true); return; }
  let added = 0, updated = 0;
  incoming.forEach(s => {
    const ex = scripts.find(x => x.id === s.id);
    if (ex){ Object.assign(ex, s); updated++; }
    else { scripts.push(s); added++; }
  });
  saveScripts();
  renderScripts(scFilter.value);
  toast('Imported ' + added + ' new, updated ' + updated);
}));

