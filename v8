const IC_OK  = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const IC_WARN= '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/></svg>';
function toast(msg, bad, act){
  const box = $('#toasts');
  const t = document.createElement('div');
  t.className = 'toast' + (bad ? ' bad' : '');
  t.innerHTML = (bad ? IC_WARN : IC_OK) + '<span></span>';
  t.querySelector('span').textContent = msg;
  let gone = false;
  const close = () => { if (gone) return; gone = true; t.classList.remove('in'); setTimeout(() => t.remove(), 320); };
  if (act){
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'toastBtn'; b.textContent = act.label;
    b.addEventListener('click', () => { close(); act.fn(); });
    t.appendChild(b);
    t.classList.add('act');
  }
  box.appendChild(t);
  requestAnimationFrame(() => t.classList.add('in'));
  setTimeout(close, (act && act.ms) || 2400);
  while (box.children.length > 3) box.removeChild(box.firstChild);
  return { close: close };
}

