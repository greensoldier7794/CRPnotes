function phTiles(raw, mode){                       // -> array of groups (one per space-separated part) of tiles
  const symbols = mode === 'code' ? PH_SYMBOLS_CODE : PH_SYMBOLS_NAME;
  return String(raw).trim().replace(/\s+/g, ' ').split(' ').map(part =>
    Array.from(part).map(c => {
